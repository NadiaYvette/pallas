index-state:
  , hackage.haskell.org 2025-10-17T00:26:22Z
  , cardano-haskell-packages 2025-11-15T00:00:00Z

-- Only our local test package; cardano-tracer, trace-forward,
-- trace-dispatcher, and trace-resources come from CHaP.
packages:
  .

test-show-details: direct

write-ghc-environment-files: always

package cryptonite
  flags: -support_rdrand

package snap-server
  flags: -openssl

package bitvec
  flags: -simd

-- Disable RTView in cardano-tracer (not needed for tests, avoids extra deps)
package cardano-tracer
  flags: -rtview

allow-newer:
  , katip:Win32
